<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mycobot_hardware</name>
  <version>0.1.0</version>
  <description>
    ros2_control SystemInterface for myCobot 280 JN.
    Bridges to pymycobot via embedded Python (pybind11).
  </description>
  <maintainer email="ekinciorhandijvar@gmail.com">Orhan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <exec_depend>python3</exec_depend>
  <!-- pymycobot installed via pip; declared informally. -->
  <exec_depend>python3-pymycobot-pip</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/mycobot_hardware_plugin.xml"/>
  </export>
</package>
